generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  CONTROL
  FLOW
  ESSENTIAL
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
  UNKNOWN
}

enum CompanyDataSource {
  BRASIL_API
  MANUAL
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum MembershipRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum MfaChallengeType {
  LOGIN
  SETUP
}

enum DigitalCertificateKind {
  A1
}

enum DigitalCertificateStatus {
  ACTIVE
  REVOKED
}

enum CompanyResponsibleRole {
  PRIMARY
  SUPPORT
}

enum CompanyResponsibleStatus {
  ACTIVE
  INACTIVE
}

enum PowerOfAttorneyStatus {
  ACTIVE
  REVOKED
}

enum CredentialAlertKind {
  EXPIRING
  EXPIRED
}

enum CredentialAlertStatus {
  OPEN
  ACKNOWLEDGED
}

enum EcacQueryType {
  TAX_STATUS
  DEBTS
  MAILBOX
}

enum EcacSyncBatchStatus {
  QUEUED
  RUNNING
  PARTIAL
  SUCCEEDED
  FAILED
}

enum EcacSyncJobStatus {
  QUEUED
  PROCESSING
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
}

enum EcacFindingSeverity {
  INFO
  WARNING
  CRITICAL
}

enum EcacAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum EcacAlertChangeType {
  NEW
  CHANGED
  REOPENED
  RESOLVED
}

enum EcacNotificationChannel {
  IN_APP
  EMAIL
}

enum EcacNotificationEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum SerproConnectionStatus {
  ACTIVE
  REVOKED
}

enum EcacSitfisStatus {
  AWAITING_PROTOCOL
  AWAITING_REPORT
  COMPLETED
}

model Tenant {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                  @unique
  plan                   Plan                    @default(CONTROL)
  companies              Company[]
  memberships            Membership[]
  invitations            Invitation[]
  digitalCertificates    DigitalCertificate[]
  companyResponsibles    CompanyResponsible[]
  powerOfAttorneys       PowerOfAttorney[]
  credentialAlerts       CredentialAlert[]
  ecacSyncBatches        EcacSyncBatch[]
  ecacSyncJobs           EcacSyncJob[]
  ecacFindings           EcacFinding[]
  ecacAlerts             EcacAlert[]
  ecacNotificationPrefs  EcacAlertNotificationPreference[]
  ecacNotificationEvents EcacAlertNotificationEvent[]
  ecacObservationCursors EcacObservationCursor[]
  ecacSitfisProcesses    EcacSitfisProcess[]
  serproConnection       SerproConnection?
  auditLogs              AuditLog[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("tenants")
}

model User {
  id                          String               @id @default(uuid()) @db.Uuid
  name                        String
  email                       String               @unique
  passwordHash                String               @map("password_hash")
  status                      UserStatus           @default(ACTIVE)
  securityVersion             Int                  @default(1) @map("security_version")
  mfaEnabledAt                DateTime?            @map("mfa_enabled_at")
  mfaSecretEncrypted          String?              @map("mfa_secret_encrypted")
  lastLoginAt                 DateTime?            @map("last_login_at")
  memberships                 Membership[]
  createdInvitations          Invitation[]         @relation("InvitationCreator")
  auditLogs                   AuditLog[]           @relation("AuditActor")
  mfaChallenges               MfaChallenge[]
  mfaRecoveryCodes            MfaRecoveryCode[]
  passwordResetTokens         PasswordResetToken[]
  uploadedCertificates        DigitalCertificate[] @relation("CertificateUploader")
  assignedResponsibilities    CompanyResponsible[] @relation("CompanyResponsibleAssigner")
  createdPowerOfAttorneys     PowerOfAttorney[]    @relation("PowerOfAttorneyCreator")
  acknowledgedAlerts          CredentialAlert[]    @relation("CredentialAlertAcknowledgedBy")
  requestedEcacBatches        EcacSyncBatch[]      @relation("EcacBatchRequester")
  acknowledgedEcacAlerts      EcacAlert[]          @relation("EcacAlertAcknowledgedBy")
  ecacNotificationPrefs       EcacAlertNotificationPreference[]
  ecacNotificationEvents      EcacAlertNotificationEvent[]
  configuredSerproConnections SerproConnection[]   @relation("SerproConnectionConfigurer")
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@map("users")
}

model Membership {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  role             MembershipRole
  status           MembershipStatus     @default(ACTIVE)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshSessions  RefreshSession[]
  mfaChallenges    MfaChallenge[]
  responsibilities CompanyResponsible[] @relation("ResponsibleMembership")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("memberships")
}

model MfaChallenge {
  id              String           @id @default(uuid()) @db.Uuid
  type            MfaChallengeType
  tokenHash       String           @unique @map("token_hash")
  userId          String           @map("user_id") @db.Uuid
  membershipId    String           @map("membership_id") @db.Uuid
  secretEncrypted String?          @map("secret_encrypted")
  expiresAt       DateTime         @map("expires_at")
  consumedAt      DateTime?        @map("consumed_at")
  failedAttempts  Int              @default(0) @map("failed_attempts")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership      Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([userId, type, consumedAt])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshSession {
  id           String     @id @default(uuid()) @db.Uuid
  familyId     String     @map("family_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  usedAt       DateTime?  @map("used_at")
  revokedAt    DateTime?  @map("revoked_at")
  ipAddress    String?    @map("ip_address")
  userAgent    String?    @map("user_agent")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([familyId])
  @@index([membershipId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Invitation {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  email       String
  role        MembershipRole
  tokenHash   String         @unique @map("token_hash")
  expiresAt   DateTime       @map("expires_at")
  acceptedAt  DateTime?      @map("accepted_at")
  createdById String         @map("created_by_id") @db.Uuid
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([tenantId, email, acceptedAt])
  @@index([expiresAt])
  @@map("invitations")
}

model Company {
  id                     String                    @id @default(uuid()) @db.Uuid
  tenantId               String                    @map("tenant_id") @db.Uuid
  cnpj                   String                    @db.Char(14)
  legalName              String                    @map("legal_name")
  tradeName              String?                   @map("trade_name")
  registrationStatus     CompanyStatus             @default(UNKNOWN) @map("registration_status")
  openingDate            DateTime?                 @map("opening_date") @db.Date
  primaryCnae            String?                   @map("primary_cnae")
  primaryCnaeDescription String?                   @map("primary_cnae_description")
  municipality           String?
  state                  String?                   @db.Char(2)
  dataSource             CompanyDataSource         @map("data_source")
  registryUpdatedAt      DateTime?                 @map("registry_updated_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificateScopes      CertificateCompanyScope[]
  responsibles           CompanyResponsible[]
  powerOfAttorneys       PowerOfAttorney[]
  ecacSyncJobs           EcacSyncJob[]
  ecacFindings           EcacFinding[]
  ecacAlerts             EcacAlert[]
  ecacObservationCursors EcacObservationCursor[]
  ecacSitfisProcesses    EcacSitfisProcess[]

  @@unique([tenantId, cnpj])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([registrationStatus])
  @@map("companies")
}

model DigitalCertificate {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  label             String
  kind              DigitalCertificateKind    @default(A1)
  status            DigitalCertificateStatus  @default(ACTIVE)
  encryptedBundle   String                    @map("encrypted_bundle")
  encryptedPassword String                    @map("encrypted_password")
  keyVersion        Int                       @map("key_version")
  fingerprintSha256 String                    @map("fingerprint_sha256") @db.Char(64)
  serialNumber      String                    @map("serial_number")
  subjectCommonName String                    @map("subject_common_name")
  issuerCommonName  String                    @map("issuer_common_name")
  validFrom         DateTime                  @map("valid_from")
  validUntil        DateTime                  @map("valid_until")
  uploadedById      String                    @map("uploaded_by_id") @db.Uuid
  revokedAt         DateTime?                 @map("revoked_at")
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy        User                      @relation("CertificateUploader", fields: [uploadedById], references: [id])
  companyScopes     CertificateCompanyScope[]
  powerOfAttorneys  PowerOfAttorney[]
  alerts            CredentialAlert[]
  ecacSyncJobs      EcacSyncJob[]
  serproConnections SerproConnection[]
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@unique([tenantId, fingerprintSha256])
  @@unique([tenantId, id])
  @@index([tenantId, status, validUntil])
  @@index([uploadedById])
  @@map("digital_certificates")
}

model CertificateCompanyScope {
  tenantId      String             @map("tenant_id") @db.Uuid
  certificateId String             @map("certificate_id") @db.Uuid
  companyId     String             @map("company_id") @db.Uuid
  certificate   DigitalCertificate @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Cascade)
  company       Company            @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  createdAt     DateTime           @default(now()) @map("created_at")

  @@id([certificateId, companyId])
  @@index([tenantId, companyId])
  @@map("certificate_company_scopes")
}

model CompanyResponsible {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  companyId        String                   @map("company_id") @db.Uuid
  membershipId     String                   @map("membership_id") @db.Uuid
  role             CompanyResponsibleRole
  status           CompanyResponsibleStatus @default(ACTIVE)
  assignedById     String                   @map("assigned_by_id") @db.Uuid
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company                  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  membership       Membership               @relation("ResponsibleMembership", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  assignedBy       User                     @relation("CompanyResponsibleAssigner", fields: [assignedById], references: [id])
  powersOfAttorney PowerOfAttorney[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@unique([tenantId, companyId, membershipId])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, status])
  @@index([membershipId, status])
  @@map("company_responsibles")
}

model PowerOfAttorney {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  companyId         String                @map("company_id") @db.Uuid
  responsibleId     String                @map("responsible_id") @db.Uuid
  certificateId     String?               @map("certificate_id") @db.Uuid
  label             String
  externalReference String?               @map("external_reference")
  services          String[]
  status            PowerOfAttorneyStatus @default(ACTIVE)
  validFrom         DateTime              @map("valid_from") @db.Date
  validUntil        DateTime              @map("valid_until") @db.Date
  createdById       String                @map("created_by_id") @db.Uuid
  revokedAt         DateTime?             @map("revoked_at")
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company               @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  responsible       CompanyResponsible    @relation(fields: [tenantId, companyId, responsibleId], references: [tenantId, companyId, id], onDelete: Restrict)
  certificate       DigitalCertificate?   @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Restrict)
  createdBy         User                  @relation("PowerOfAttorneyCreator", fields: [createdById], references: [id])
  alerts            CredentialAlert[]
  ecacSyncJobs      EcacSyncJob[]
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([tenantId, externalReference])
  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, status, validUntil])
  @@index([companyId, status])
  @@index([responsibleId, status])
  @@index([certificateId])
  @@map("powers_of_attorney")
}

model CredentialAlert {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  certificateId     String?               @map("certificate_id") @db.Uuid
  powerOfAttorneyId String?               @map("power_of_attorney_id") @db.Uuid
  kind              CredentialAlertKind
  status            CredentialAlertStatus @default(OPEN)
  thresholdDays     Int                   @map("threshold_days")
  dueAt             DateTime              @map("due_at")
  acknowledgedAt    DateTime?             @map("acknowledged_at")
  acknowledgedById  String?               @map("acknowledged_by_id") @db.Uuid
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificate       DigitalCertificate?   @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Cascade)
  powerOfAttorney   PowerOfAttorney?      @relation(fields: [tenantId, powerOfAttorneyId], references: [tenantId, id], onDelete: Cascade)
  acknowledgedBy    User?                 @relation("CredentialAlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([tenantId, certificateId, kind, thresholdDays, dueAt])
  @@unique([tenantId, powerOfAttorneyId, kind, thresholdDays, dueAt])
  @@index([tenantId, status, dueAt])
  @@index([certificateId])
  @@index([powerOfAttorneyId])
  @@map("credential_alerts")
}

model EcacSyncBatch {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  requestKey    String              @map("request_key")
  targetHash    String              @map("target_hash") @db.Char(64)
  queryType     EcacQueryType       @map("query_type")
  status        EcacSyncBatchStatus @default(QUEUED)
  requestedById String              @map("requested_by_id") @db.Uuid
  totalJobs     Int                 @map("total_jobs")
  succeededJobs Int                 @default(0) @map("succeeded_jobs")
  failedJobs    Int                 @default(0) @map("failed_jobs")
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy   User                @relation("EcacBatchRequester", fields: [requestedById], references: [id])
  jobs          EcacSyncJob[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, requestKey])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("ecac_sync_batches")
}

model EcacSyncJob {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  batchId            String                  @map("batch_id") @db.Uuid
  companyId          String                  @map("company_id") @db.Uuid
  powerOfAttorneyId  String                  @map("power_of_attorney_id") @db.Uuid
  certificateId      String                  @map("certificate_id") @db.Uuid
  queryType          EcacQueryType           @map("query_type")
  observationOrder   BigInt                  @default(autoincrement()) @map("observation_order")
  status             EcacSyncJobStatus       @default(QUEUED)
  provider           String?
  protocol           String?
  attemptCount       Int                     @default(0) @map("attempt_count")
  maxAttempts        Int                     @default(5) @map("max_attempts")
  nextAttemptAt      DateTime                @default(now()) @map("next_attempt_at")
  lockedAt           DateTime?               @map("locked_at")
  lockToken          String?                 @map("lock_token") @db.Uuid
  startedAt          DateTime?               @map("started_at")
  completedAt        DateTime?               @map("completed_at")
  errorCode          String?                 @map("error_code")
  errorMessage       String?                 @map("error_message")
  responseHash       String?                 @map("response_hash") @db.Char(64)
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch              EcacSyncBatch           @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Cascade)
  company            Company                 @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  powerOfAttorney    PowerOfAttorney         @relation(fields: [tenantId, companyId, powerOfAttorneyId], references: [tenantId, companyId, id], onDelete: Restrict)
  certificate        DigitalCertificate      @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Restrict)
  findings           EcacFinding[]
  latestAlerts       EcacAlert[]             @relation("EcacAlertLatestJob")
  observationCursors EcacObservationCursor[] @relation("EcacObservationLatestJob")
  sitfisProcess      EcacSitfisProcess?
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@unique([batchId, companyId])
  @@unique([observationOrder])
  @@unique([tenantId, id])
  @@index([tenantId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
  @@index([tenantId, companyId, createdAt])
  @@index([lockedAt])
  @@map("ecac_sync_jobs")
}

model EcacSitfisProcess {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  jobId              String           @unique @map("job_id") @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  status             EcacSitfisStatus @default(AWAITING_PROTOCOL)
  encryptedProtocol  String?          @map("encrypted_protocol")
  protocolKeyVersion Int?             @map("protocol_key_version")
  protocolHash       String?          @map("protocol_hash") @db.Char(64)
  nextAttemptAt      DateTime?        @map("next_attempt_at")
  providerStatus     Int?             @map("provider_status")
  reportHash         String?          @map("report_hash") @db.Char(64)
  completedAt        DateTime?        @map("completed_at")
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job                EcacSyncJob      @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Cascade)
  company            Company          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, jobId])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, companyId, createdAt])
  @@map("ecac_sitfis_processes")
}

model EcacFinding {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  jobId           String              @map("job_id") @db.Uuid
  code            String
  category        String
  title           String
  description     String?
  severity        EcacFindingSeverity
  sourceReference String?             @map("source_reference")
  observedAt      DateTime            @map("observed_at")
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  job             EcacSyncJob         @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Cascade)
  createdAt       DateTime            @default(now()) @map("created_at")

  @@unique([jobId, code, sourceReference])
  @@index([tenantId, companyId, severity, observedAt])
  @@index([tenantId, category, observedAt])
  @@map("ecac_findings")
}

model EcacAlert {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  latestJobId      String              @map("latest_job_id") @db.Uuid
  queryType        EcacQueryType       @map("query_type")
  findingKey       String              @map("finding_key") @db.Char(64)
  contentHash      String              @map("content_hash") @db.Char(64)
  code             String
  category         String
  title            String
  description      String?
  severity         EcacFindingSeverity
  status           EcacAlertStatus     @default(OPEN)
  lastChangeType   EcacAlertChangeType @map("last_change_type")
  firstObservedAt  DateTime            @map("first_observed_at")
  lastObservedAt   DateTime            @map("last_observed_at")
  acknowledgedAt   DateTime?           @map("acknowledged_at")
  acknowledgedById String?             @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime?           @map("resolved_at")
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  latestJob        EcacSyncJob         @relation("EcacAlertLatestJob", fields: [tenantId, latestJobId], references: [tenantId, id], onDelete: Restrict)
  acknowledgedBy   User?               @relation("EcacAlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  notificationEvents EcacAlertNotificationEvent[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, companyId, queryType, findingKey])
  @@unique([tenantId, id])
  @@index([tenantId, status, severity, updatedAt])
  @@index([tenantId, companyId, queryType, status])
  @@index([latestJobId])
  @@index([acknowledgedById])
  @@map("ecac_alerts")
}

model EcacAlertNotificationPreference {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  channel         EcacNotificationChannel
  enabled         Boolean                 @default(true)
  minimumSeverity EcacFindingSeverity     @default(WARNING) @map("minimum_severity")
  includeResolved Boolean                 @default(false) @map("include_resolved")
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@unique([tenantId, userId, channel])
  @@index([tenantId, userId])
  @@map("ecac_alert_notification_preferences")
}

model EcacAlertNotificationEvent {
  id           String                      @id @default(uuid()) @db.Uuid
  tenantId     String                      @map("tenant_id") @db.Uuid
  alertId      String                      @map("alert_id") @db.Uuid
  userId       String                      @map("user_id") @db.Uuid
  companyId    String                      @map("company_id") @db.Uuid
  queryType    EcacQueryType               @map("query_type")
  channel      EcacNotificationChannel
  status       EcacNotificationEventStatus @default(PENDING)
  changeType   EcacAlertChangeType         @map("change_type")
  severity     EcacFindingSeverity
  title        String
  dedupeKey    String                      @map("dedupe_key") @db.Char(64)
  scheduledAt  DateTime                    @map("scheduled_at")
  attemptCount Int                         @default(0) @map("attempt_count")
  maxAttempts  Int                         @default(3) @map("max_attempts")
  processingStartedAt DateTime?            @map("processing_started_at")
  lastAttemptedAt DateTime?                @map("last_attempted_at")
  deliveredAt  DateTime?                   @map("delivered_at")
  failedAt     DateTime?                   @map("failed_at")
  failureCode  String?                     @map("failure_code")
  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alert        EcacAlert                   @relation(fields: [tenantId, alertId], references: [tenantId, id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")

  @@unique([tenantId, dedupeKey])
  @@unique([tenantId, id])
  @@index([tenantId, userId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([status, processingStartedAt])
  @@index([tenantId, alertId])
  @@map("ecac_alert_notification_events")
}

model EcacObservationCursor {
  tenantId               String        @map("tenant_id") @db.Uuid
  companyId              String        @map("company_id") @db.Uuid
  queryType              EcacQueryType @map("query_type")
  latestJobId            String        @map("latest_job_id") @db.Uuid
  latestObservationOrder BigInt        @map("latest_observation_order")
  lastObservedAt         DateTime      @map("last_observed_at")
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                Company       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  latestJob              EcacSyncJob   @relation("EcacObservationLatestJob", fields: [tenantId, latestJobId], references: [tenantId, id], onDelete: Restrict)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@id([tenantId, companyId, queryType])
  @@index([latestJobId])
  @@map("ecac_observation_cursors")
}

model SerproConnection {
  id                      String                 @id @default(uuid()) @db.Uuid
  tenantId                String                 @unique @map("tenant_id") @db.Uuid
  certificateId           String                 @map("certificate_id") @db.Uuid
  contractorCnpj          String                 @map("contractor_cnpj") @db.Char(14)
  requesterCnpj           String                 @map("requester_cnpj") @db.Char(14)
  encryptedConsumerKey    String                 @map("encrypted_consumer_key")
  encryptedConsumerSecret String                 @map("encrypted_consumer_secret")
  keyVersion              Int                    @map("key_version")
  status                  SerproConnectionStatus @default(ACTIVE)
  configuredById          String                 @map("configured_by_id") @db.Uuid
  revokedAt               DateTime?              @map("revoked_at")
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificate             DigitalCertificate     @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Restrict)
  configuredBy            User                   @relation("SerproConnectionConfigurer", fields: [configuredById], references: [id])
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([certificateId])
  @@map("serpro_connections")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model TaxParameterVersion {
  id            String    @id @default(uuid()) @db.Uuid
  parameterType String    @map("parameter_type")
  jurisdiction  String
  validFrom     DateTime  @map("valid_from") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date
  sourceUrl     String    @map("source_url")
  sourceHash    String    @map("source_hash")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([parameterType, jurisdiction, validFrom])
  @@index([parameterType, jurisdiction, validFrom])
  @@map("tax_parameter_versions")
}
