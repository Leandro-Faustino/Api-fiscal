# Ambiente de demonstração do Integra Contador.
#
# Este é o token público de demonstração publicado pelo SERPRO na documentação
# da API. Não é segredo e não dá acesso a dado fiscal real: o ambiente devolve
# cenários fixos. Nunca use em produção — a validação de ambiente recusa este
# Bearer quando NODE_ENV=production ou quando a URL não é a de trial.
#
# Uso:
#   set -a && source .env.trial.example && set +a
#   npm run smoke:serpro-trial -- CAIXAPOSTAL MSGCONTRIBUINTE61 1.0

SERPRO_API_BASE_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador-trial/v1
SERPRO_TRIAL_BEARER=06aef429-a981-3ec5-a1f8-71d38d86481e
SERPRO_TIMEOUT_MS=15000

# CNPJs dos cenários de demonstração. Ajuste conforme a página de cenários do
# serviço que estiver sendo inspecionado.
SERPRO_TRIAL_CONTRACTOR_CNPJ=00000000000000
SERPRO_TRIAL_REQUESTER_CNPJ=00000000000000
SERPRO_TRIAL_TAXPAYER_CNPJ=00000000000000
